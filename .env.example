# Backend environment
# Copy to .env and fill in real values

# Frontend build: URL of the backend API
VITE_API_URL=http://localhost:8000

# Set to true to allow unauthenticated dev access
DEMO_MODE=false

# Auth secret (generate e.g. with: openssl rand -hex 32)
SECRET=change-me

# Search provider: local (SearXNG) | remote (hosted APIs)
SEARCH_PROVIDER=local

# --- Search/rerank API keys (needed only for SEARCH_PROVIDER=remote) ---
TAVILY_API=
EXA_API=

# --- Model provider keys (referenced by backend/config.json api_key_env) ---
OPENROUTER_API_KEY=
# COMMANDCODE_API_KEY=

# --- Embeddings / reranking ---
# limit of search results to pass to reranker
EMBEDDING_SEARCH_LIMIT=20
# for now litellm only
EMBEDDING_RUNNER=litellm
# litellm | local (huggingface models)
RERANKER_RUNNER=litellm
EMBEDDING_MODEL=openrouter/perplexity/pplx-embed-v1-0.6b
# due to litellm missing support to openrouter instead of openrouter/ cohere/ must be used
# due to a sketchy fix anything else than openrouter doesn't work
RERANKER_MODEL=voyageai/rerank-2.5-lite
