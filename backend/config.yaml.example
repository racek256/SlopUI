app:
  demo_mode: false # allows creating temp accounts
  account_creation: true # allow public signup — turn off to close registration
  log_level: info
  search_provider: remote # local|remote
search:
  provider: remote # local/remote
  tavily: enabled # if remote
  exa: enabled # if remote
embedding: # OpenAI-compatible, called via litellm WITHOUT provider-prefix routing
  baseURL: "https://example.com/v1"
  api_key_env: "EMBEDDING_API_KEY"
  model: "example-embed-model"
  search_limit: 20
reranker: # any Cohere-compatible /rerank endpoint, called via plain httpx
  baseURL: "https://example.com/v1"
  api_key_env: "RERANKER_API_KEY"
  model: "example-rerank-model"
  chunks_limit: 35 # amount of chunks that can enter reranker (sorted)
memory: # OpenAI-compatible custom provider, called via litellm with provider-prefix routing
  provider: example-provider
  baseURL: "https://example.com/v1" # omit/null when the provider is a LiteLLM builtin
  api_key_env: "MEMORY_API_KEY" # NAME of the env var holding the key, never the key itself
  model: "example-provider/example-model" # model id used for parsing/compacting
  filter_model: "example-provider/example-model" # model used by memory_filter
models:
  - provider: openrouter
    format: builtin
    api_key_env: OPENROUTER_API_KEY # <-- only reference, value stays in .env
    models: [{id: "openrouter/qwen/qwen3.7-flash", name: "Qwen 3.7 flash"}]
  - provider: openai-provider
    baseURL: https://example.com/v1
    format: openai
    api_key_env: PROVIDER_API_KEY
    models: [{id: "provider/really-good-model", name: "really good model"}]
MCPS:
  - name: your-favorite-mcp
    command: "/path/to/your/mcp"
    args:
      - any
      - argument
 
